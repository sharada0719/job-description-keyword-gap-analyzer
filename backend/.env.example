# Copy this file to .env and fill in your values.
# Never commit the actual .env file.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Job Gap Analyzer"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development          # development | production

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ──────────────────────────────────────────────────────────────────
# For local development (SQLite): leave DATABASE_URL empty and set SQLITE_PATH.
# For production (PostgreSQL on Render): set DATABASE_URL to the Render internal URL.
#
# PostgreSQL example (Render):
#   DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname
#
# SQLite fallback (local dev):
DATABASE_URL=
SQLITE_PATH=./jobgap.db

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── File Upload ───────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=5
ALLOWED_EXTENSIONS=pdf,docx,doc

# ── Hosted AI ─────────────────────────────────────────────────────────────────
AI_PROVIDER=gemini
AI_ANALYSIS_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
SIMILARITY_THRESHOLD=0.75
UNCERTAIN_MATCH_MIN=0.60

# ATS compatibility threshold [0.0–1.0].
# The ATS-friendly success popup is shown only when a resume meets this score
# AND the required parsing/compatibility checks pass.
ATS_COMPATIBILITY_THRESHOLD=0.80

# ── Job Recommendations ────────────────────────────────────────────────────────
# Optional future API key for live job listings (not currently used).
# When set, the recommendations endpoint can be extended to append live data.
# JSEARCH_API_KEY=

# ── Google Gemini AI ───────────────────────────────────────────────────────────
# Used for cover letters when AI_PROVIDER=gemini. Get a key at:
#   https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.0-flash

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs

# ── SMTP / Email (Forgot Password) ───────────────────────────────────────────
# Required to enable the Forgot Password email feature.
# Leave SMTP_HOST empty to disable email sending (the endpoint will return
# status='unavailable' with a clear error message instead).
#
# Gmail example (use an App Password, not your account password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=<16-char App Password>
#   SMTP_FROM_EMAIL=you@gmail.com
#
# Other providers: Outlook (smtp-mail.outlook.com:587), SendGrid (smtp.sendgrid.net:587), etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Job Description Keyword Gap Analyzer
SMTP_TLS=true
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Frontend URL — used to build the reset link in the email.
# Change to your deployed frontend URL in production.
FRONTEND_BASE_URL=http://localhost:5173
