# Copy this file to .env and fill in your values.
# Never commit the actual .env file.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Job Gap Analyzer"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development          # development | production

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (SQLite) ─────────────────────────────────────────────────────────
# Path to the SQLite file. Relative to the directory you run uvicorn from.
# In Docker, set to /app/data/jobgap.db (mounted volume).
SQLITE_PATH=./jobgap.db

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── File Upload ───────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=5
ALLOWED_EXTENSIONS=pdf,docx,doc

# ── NLP / AI ──────────────────────────────────────────────────────────────────
SPACY_MODEL=en_core_web_sm
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
KEYBERT_TOP_N=20
SIMILARITY_THRESHOLD=0.75

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
